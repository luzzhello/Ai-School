FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

RUN mkdir -p /ruoyi/server/logs /ruoyi/upload

COPY ruoyi-admin.jar /app/ruoyi-admin.jar

EXPOSE 6039

ENV SERVER_PORT=6039
ENV JAVA_OPTS="-Xms512m -Xmx1536m -XX:+UseG1GC"

ENTRYPOINT ["sh", "-c", "java -Djava.security.egd=file:/dev/./urandom -Dserver.port=${SERVER_PORT} ${JAVA_OPTS} -jar /app/ruoyi-admin.jar --spring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod}"]
